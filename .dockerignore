# Build context for the verifier image. The Dockerfile copies only: pyproject.toml, uv.lock,
# README.md, LICENSE, worldline/, service/, policies/{release.yaml,kernel_public.pem}, ui/ and
# experiments/ (for the viewer's data). Everything else stays out to keep uploads small.
.git
.gitlab
.venv
.cache
.hypothesis
.pytest_cache
__pycache__
**/__pycache__
*.pyc
node_modules
ui/node_modules
ui/dist
ui/public/data
docs
tests
scripts
examples
experiments/out_real
experiments/out_http
report.xml
duo
.env
.env.*
# Never ship the signing key.
policies/kernel_private.pem
**/*.pem
!policies/kernel_public.pem
