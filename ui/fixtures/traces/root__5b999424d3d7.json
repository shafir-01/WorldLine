  "decision_rules": [
    {
      "id": "raise_alert",
      "actor": "harbour_ops.actor",
      "role": "harbour_ops",
      "at_ns": 600000000000,
      "window_ns": 600000000000,
      "when": "count(kind='sighting', payload.confidence>=0.6) >= 2",
      "then": "raise_amber_alert",
      "otherwise": "monitor"
    },
    {
      "id": "dispatch_cutter",
      "actor": "coast_guard.actor",
      "role": "coast_guard",
      "at_ns": 1500000000000,
      "window_ns": 1500000000000,
      "when": "exists(kind='alert', payload.level='amber') and not exists(kind='correction')",
      "then": "dispatch_cutter",
      "otherwise": "hold"
    },
    {
      "id": "stand_down",
      "actor": "harbour_ops.actor",
      "role": "harbour_ops",
      "at_ns": 2700000000000,
      "window_ns": 2700000000000,
      "when": "exists(kind='correction') or count(kind='sighting', payload.confidence<0.4) >= 1",
      "then": "stand_down",
      "otherwise": "keep_alert"
    }
